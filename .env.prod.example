# Шаблон ПРОД-окружения. На сервере скопировать в .env рядом с docker-compose.prod.yml
# и заполнить реальными значениями. Файл .env в git не коммитится.

# PostgreSQL — задайте надёжный пароль
POSTGRES_USER=teacher
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=teacher
DATABASE_URL=postgresql+asyncpg://teacher:CHANGE_ME_strong_db_password@postgres:5432/teacher

# JWT — обязательно длинный случайный секрет; DEV_MODE=false (иначе backend упадёт на старте)
JWT_SECRET=CHANGE_ME_long_random_string
JWT_TTL_HOURS=24
DEV_MODE=false
# Secure-cookie включать ТОЛЬКО за HTTPS. Сейчас доступ по http://IP:80 — оставить false,
# иначе cookie не отправится и логин сломается. После настройки TLS — переключить на true.
SECURE_COOKIES=false

# Seed-учётки (создаются при первом старте, если не существуют) — смените пароли!
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=CHANGE_ME_admin_password
TEACHER_EMAIL=teacher@example.com
TEACHER_PASSWORD=CHANGE_ME_teacher_password

# Почта: console — письма в лог; smtp — реальная отправка
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# За сколько часов до урока напоминать ученику
REMINDER_HOURS=24

# Планировщик (дайджест, напоминания, выписки) в проде включён
SCHEDULER_ENABLED=true
DIGEST_HOUR=7
TZ=Asia/Yekaterinburg
