# PostgreSQL
POSTGRES_USER=teacher
POSTGRES_PASSWORD=teacher
POSTGRES_DB=teacher
DATABASE_URL=postgresql+asyncpg://teacher:teacher@postgres:5432/teacher

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=24

# Seed-учётки (создаются при старте, если не существуют)
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=admin12345
TEACHER_EMAIL=teacher@example.com
TEACHER_PASSWORD=teacher12345

# Почта: console — письма пишутся в лог
EMAIL_BACKEND=console

# Ежедневный дайджест учителю
SCHEDULER_ENABLED=true
DIGEST_HOUR=7
TZ=Europe/Moscow
