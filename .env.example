# PostgreSQL
POSTGRES_USER=teacher
POSTGRES_PASSWORD=teacher
POSTGRES_DB=teacher
DATABASE_URL=postgresql+asyncpg://teacher:teacher@postgres:5432/teacher

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=24

# Seed-учётки (создаются при старте, если не существуют)
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=admin12345
TEACHER_EMAIL=teacher@example.com
TEACHER_PASSWORD=teacher12345

# Почта: console — письма в лог; smtp — реальная отправка
EMAIL_BACKEND=console
# Для EMAIL_BACKEND=smtp (Gmail: smtp.gmail.com:587 + пароль приложения;
# Яндекс: smtp.yandex.ru:465)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# За сколько часов до урока напоминать ученику
REMINDER_HOURS=24

# Ежедневный дайджест учителю
SCHEDULER_ENABLED=true
DIGEST_HOUR=7
TZ=Europe/Moscow
